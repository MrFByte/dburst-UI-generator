# ==============================================================
# APP SETTINGS
# ==============================================================
APP_MODE=development
DEBUG=True

# ==============================================================
# NETWORK SECURITY (hosts, CORS, CSRF)
# ==============================================================
ALLOWED_HOSTS=localhost,127.0.0.1,yourdomain.onrender.com
CORS_ALLOW_CREDENTIALS=True
CORS_ALLOWED_ORIGINS=https://yourdomain.vercel.app,http://localhost:5173,https://localhost:5173
# Must include the Vercel origin: requests arrive through vercel.json's /api
# rewrite, so their Origin is the Vercel host while Host is Render.
CSRF_TRUSTED_ORIGINS=https://yourdomain.vercel.app,https://yourdomain.onrender.com,http://localhost:5173,https://localhost:5173
# No "authorization" — auth is cookie-only; x-csrftoken is required.
CORS_ALLOW_HEADERS=accept,accept-encoding,content-type,dnt,origin,user-agent,x-csrftoken,x-requested-with,ngrok-skip-browser-warning

# Auth cookie flags. Defaults (COOKIE_SECURE=True, COOKIE_SAMESITE=Lax) are
# for production, where the API is first-party via the Vercel /api rewrite.
# Use SameSite=None only if the browser calls the backend domain directly.
# Local dev runs over plain HTTP (see run.sh) and Secure cookies are dropped
# over HTTP, so uncomment this for local dev:
# COOKIE_SECURE=False
# COOKIE_SAMESITE=Lax

# OAuth redirect URIs the backend accepts (exact match). Must also be
# registered in the Google Cloud / GitHub OAuth app consoles.
# GOOGLE_ALLOWED_REDIRECT_URIS=https://yourdomain.vercel.app/auth/google/callback,http://localhost:5173/auth/google/callback
# GITHUB_ALLOWED_REDIRECT_URIS=https://yourdomain.vercel.app/auth/github/callback,http://localhost:5173/auth/github/callback

# Auth endpoint throttles (DRF rate strings) and proxy depth for client-IP
# detection. Vercel rewrite -> Render is typically 2 proxies; verify.
# THROTTLE_RATE_AUTH=20/min
# THROTTLE_RATE_OTP=5/min
# THROTTLE_RATE_TOKEN_REFRESH=30/min
# THROTTLE_NUM_PROXIES=2

# ==============================================================
# DJANGO SECRET KEY (required — the app refuses to start without it)
# generate one with: python -c "import secrets,string;print(''.join(secrets.choice(string.ascii_letters+string.digits+'!@#$%^&*(-_=+)') for _ in range(64)))"
# ==============================================================
SECRET_KEY=change-me-to-a-random-50-plus-character-string

# ==============================================================
# OAUTH CREDENTIALS (Google / GitHub)
# ==============================================================
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret

# ==============================================================
# AI PROVIDER KEYS (Groq / Gemini)
# ==============================================================
GROQ_AI_API_KEY=your-groq-api-key
GEMINI_API_KEY=your-gemini-api-key

# ==============================================================
# AI MODELS — comma-separated model IDs per provider, selectable from the
# frontend. When a provider deprecates/renames a model, update it here —
# no code change needed. REASONING_MODEL is the "planner" stage model used
# alongside whichever UI model the user picks — it always matches that
# model's provider (see generation/llm_models.py).
# ==============================================================
GROQ_UI_MODELS=openai/gpt-oss-20b,openai/gpt-oss-120b
GROQ_REASONING_MODEL=openai/gpt-oss-120b
GEMINI_UI_MODELS=models/gemini-3.5-flash-lite
GEMINI_REASONING_MODEL=models/gemini-3.8-flash
DEFAULT_UI_MODEL=groq:openai/gpt-oss-20b

# ==============================================================
# IMAGES — resolves real photos for generated Image components from an
# "alt" text via the Pixabay API (https://pixabay.com/api/docs/ — free,
# instant key, no approval/review needed). Without a key, images fall back
# to a placehold.co placeholder instead of a hallucinated, broken URL. See
# generation/images.py.
# ==============================================================
PIXABAY_API_KEY=your-pixabay-api-key
IMAGE_SEARCH_MAX_CALLS_PER_GENERATION=10
IMAGE_CACHE_TTL_SECONDS=604800

# ==============================================================
# DATABASE (PostgreSQL connection string)
# ==============================================================
DATABASE_URL=postgresql://user:password@host:5432/dbname

# ==============================================================
# CACHE / SESSION STORE (Redis)
# ==============================================================
REDIS_URL=redis://127.0.0.1:6379/1

# ==============================================================
# WEBHOOKS & NOTIFICATIONS
# ==============================================================
DISCORD_WEBHOOK=your-discord-webhook-url

# ==============================================================
# EMAIL (OTP sign-in delivery)
# ==============================================================
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-email-app-password
DEFAULT_FROM_EMAIL=your-email@gmail.com

# ==============================================================
# ERROR MONITORING (Sentry) — leave blank to disable
# ==============================================================
SENTRY_DSN=your-sentry-dsn
