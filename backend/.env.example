# ==============================================================
# APP SETTINGS
# ==============================================================
APP_MODE=development
DEBUG=True

# ==============================================================
# NETWORK SECURITY (hosts, CORS, CSRF)
# ==============================================================
ALLOWED_HOSTS=localhost,127.0.0.1,yourdomain.onrender.com
CORS_ALLOW_CREDENTIALS=True
CORS_ALLOWED_ORIGINS=https://yourdomain.vercel.app,http://localhost:5173,https://localhost:5173
CSRF_TRUSTED_ORIGINS=https://yourdomain.vercel.app,https://yourdomain.onrender.com,http://localhost:5173,https://localhost:5173
CORS_ALLOW_HEADERS=accept,accept-encoding,authorization,content-type,dnt,origin,user-agent,x-csrftoken,x-requested-with,ngrok-skip-browser-warning

# ==============================================================
# DJANGO SECRET KEY
# generate one with: python -c "import secrets,string;print(''.join(secrets.choice(string.ascii_letters+string.digits+'!@#$%^&*(-_=+)') for _ in range(64)))"
# ==============================================================
SECRET_KEY=change-me-to-a-random-50-plus-character-string

# ==============================================================
# OAUTH CREDENTIALS (Google / GitHub)
# ==============================================================
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret

# ==============================================================
# AI PROVIDER KEYS (Groq / Gemini)
# ==============================================================
GROQ_AI_API_KEY=your-groq-api-key
GEMINI_API_KEY=your-gemini-api-key

# ==============================================================
# DATABASE (PostgreSQL connection string)
# ==============================================================
DATABASE_URL=postgresql://user:password@host:5432/dbname

# ==============================================================
# CACHE / SESSION STORE (Redis)
# ==============================================================
REDIS_URL=redis://127.0.0.1:6379/1

# ==============================================================
# WEBHOOKS & NOTIFICATIONS
# ==============================================================
DISCORD_WEBHOOK=your-discord-webhook-url

# ==============================================================
# ERROR MONITORING (Sentry) — leave blank to disable
# ==============================================================
SENTRY_DSN=your-sentry-dsn
