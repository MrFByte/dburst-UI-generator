{
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/auth/(.*)",
      "destination": "/index.html"
    },
    {
      "source": "/((?!api/|static/|assets/|favicon.ico|dburst-logo.png|.*\\..*).*)",
      "destination": "/index.html"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}