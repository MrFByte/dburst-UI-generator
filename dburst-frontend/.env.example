# ==============================================================
# BACKEND API
# ==============================================================
# No API URL variable: the app always calls the same-origin path /api/v1/.
# In dev, vite.config.ts proxies /api to http://localhost:8000; on Vercel,
# vercel.json rewrites /api/* to the Render backend. Keeping the API
# same-origin is what lets the httpOnly auth cookies be first-party
# (SameSite=Lax). To point at a different backend, edit those two files.

# ==============================================================
# OAUTH CLIENT IDS (Google / GitHub)
# ==============================================================
VITE_GOOGLE_CLIENT_ID='your google client id'
VITE_GITHUB_CLIENT_ID='your github client id'

# ==============================================================
# WEBCONTAINER
# ==============================================================
VITE_WEBCONTAINER_API_CLIENT_ID='your webcontainer api client id'
