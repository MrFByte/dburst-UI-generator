backend/.pytest_cache/
backend/.coverage
backend/htmlcov/
backend/staticfiles/
backend/logs/
backend/*.log
backend/localhost+2.crt
backend/localhost+2.key
backend/MANUAL_TESTING_GUIDE.md

# Frontend: not needed inside the backend image at all
dburst-frontend/node_modules/
dburst-frontend/dist/
dburst-frontend/dist-ssr/
dburst-frontend/coverage/

